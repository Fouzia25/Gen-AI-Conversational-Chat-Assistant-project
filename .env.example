# ------------------------------------------------------------------
# TEMPLATE ONLY - safe to share and commit to Git.
#
# How to use:
#   1. Copy this file and name the copy ".env"
#   2. In .env, replace the placeholder below with your real key
#   3. NEVER share or commit .env (it is listed in .gitignore)
# ------------------------------------------------------------------

# Your OpenAI API key, from https://platform.openai.com/api-keys
# Note: API usage is billed separately from a ChatGPT Plus/Pro subscription.
OPENAI_API_KEY=your-api-key-here

# Which OpenAI model to use. Current options (Oct 2026):
#   gpt-6-luna   -> low cost, fast (good default for learning)
#   gpt-6.1-sol  -> balanced intelligence and cost
#   gpt-6-astra  -> flagship, most capable, most expensive
OPENAI_MODEL=gpt-6-luna

# How many recent messages (user + assistant) the bot remembers.
MAX_HISTORY_MESSAGES=10
